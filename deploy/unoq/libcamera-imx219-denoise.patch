+void CamssIspOpe::denoiseBayer(uint32_t frame, const FrameBuffer *buffer, MappedFrameBuffer &input)
+{
+	const size_t bytes = static_cast<size_t>(bayerStride_) * Imx219RawDenoise::height;
+	auto plane = input.planes()[0];
+	const CamssFrames::Info *info = frameInfos_->find(frame);
+	if (plane.size() < bytes || !info ||
+	    !info->effectiveSensorControls.contains(V4L2_CID_ANALOGUE_GAIN) ||
+	    !info->effectiveSensorControls.contains(V4L2_CID_EXPOSURE)) {
+		previousBayer_.clear();
+		return;
+	}
+
+	const auto &controls = info->effectiveSensorControls;
+	const int code = controls.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
+	const int lines = controls.get(V4L2_CID_EXPOSURE).get<int32_t>();
+	/* IMX219 gain = 256/(256-code), engage only above 1.8x. */
+	if (code < 114 || code > 232 || lines <= 0) {
+		previousBayer_.clear();
+		return;
+	}
+	const float gain = 256.0f / (256 - code);
+	const float exposureValue = gain * lines;
+	const unsigned int sequence = buffer->metadata().sequence;
+	if (previousBayer_.size() != bytes || sequence != previousSequence_ + 1 ||
+	    std::abs(exposureValue - previousExposureValue_) > 0.08f * exposureValue)
+		previousBayer_.assign(plane.begin(), plane.begin() + bytes);
+	else {
+		Imx219RawDenoise(gain).apply(plane.data(), previousBayer_.data(), bayerStride_);
+		if (!denoiseReported_) {
+			LOG(Camss, Info) << "IMX219 RAW10 temporal denoise active";
+			denoiseReported_ = true;
+		}
+	}
+
+	previousSequence_ = sequence;
+	previousExposureValue_ = exposureValue;
+}
