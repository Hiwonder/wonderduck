# Paths relative to the WonderDuck installation.
WONDERDUCK_UNOQ_ROUTER=/run/arduino-router.sock
WONDERDUCK_HEAD_IMU_ADDRESS=0x6a
# Enable each expansion sensor when its hardware revision is ready.
WONDERDUCK_UNOQ_TOF_ENABLED=false
WONDERDUCK_UNOQ_HEAD_IMU_ENABLED=false
WONDERDUCK_SERVO_PORT=/run/wonderduck-unoq/bus
WONDERDUCK_CAMERA_BACKEND=auto
WONDERDUCK_CAMERA_ROTATION=180
