[Unit]
Description=WonderDuck Arduino UNO Q motor bus bridge
BindsTo=arduino-router.service
After=arduino-router.service
RequiresMountsFor=/home/arduino/wonderduck

[Service]
Type=exec
EnvironmentFile=/home/arduino/wonderduck/deploy/unoq/board.env
ExecStart=/usr/bin/python3 /home/arduino/wonderduck/deploy/unoq/unoq_io.py --port ${WONDERDUCK_SERVO_PORT} --owner arduino
ExecStartPost=/bin/sh -ec 'while ! test -c "$${WONDERDUCK_SERVO_PORT}"; do sleep 0.1; done'
RuntimeDirectory=wonderduck-unoq
TimeoutStartSec=15s
Restart=on-failure
RestartSec=2s
