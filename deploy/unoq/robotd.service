[Unit]
Description=WonderDuck controller on Arduino UNO Q
BindsTo=wonderduck-unoq-bridge.service
After=wonderduck-unoq-bridge.service
RequiresMountsFor=/home/arduino/wonderduck

[Service]
Type=exec
WorkingDirectory=/home/arduino/wonderduck
Group=arduino
Environment=WONDERDUCK_UNOQ_FEEDBACK=1
Environment=WONDERDUCK_MOTION_CPU_MIN_KHZ=1612800
Environment=WONDERDUCK_MOTION_CPU_DMA_LATENCY_US=100
ExecStart=/bin/sh /home/arduino/wonderduck/deploy/unoq/run-robotd.sh
ExecStopPost=/bin/sh -ec 'if test -s /run/robotd/motion-cpu-min-khz; then cat /run/robotd/motion-cpu-min-khz > /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq; fi'
RuntimeDirectory=robotd webpadd
KillMode=mixed
# Run robotd's sit and torque-release sequence before a systemd restart.
KillSignal=SIGINT
TimeoutStopSec=25s

[Install]
WantedBy=multi-user.target
