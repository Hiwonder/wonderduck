+static int imx219_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_pad_config *cfg,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	struct imx219 *priv = to_imx219(client);
+	const struct imx219_mode *mode;
+
+	if (fse->pad != 0 || fse->index >= priv->cfg_num ||
+	    fse->code != imx219_mbus_code(priv))
+		return -EINVAL;
+
+	mode = &supported_modes[fse->index];
+	fse->min_width = fse->max_width = mode->width;
+	fse->min_height = fse->max_height = mode->height;
+	return 0;
+}
