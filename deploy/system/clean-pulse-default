#!/bin/sh
set -eu

config=${1:-/etc/pulse/default.pa}
sed -i \
  -e '/^load-module module-rescue-streams$/d' \
  -e '/^set-default-source alsa_input[.]platform-es8388-sound[.]HiFi__hw_rockchipes8388__source$/d' \
  -e '/^set-default-sink alsa_output[.]platform-es8388-sound[.]HiFi__hw_rockchipes8388__sink$/d' \
  -e '/^set-default-source alsa_input[.]platform-rk809-sound[.]HiFi__hw_rockchiprk809__source$/d' \
  -e '/^set-default-sink alsa_output[.]platform-rk809-sound[.]HiFi__hw_rockchiprk809__sink$/d' \
  "$config"
